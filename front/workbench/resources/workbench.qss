QWidget {
    font-family: "Microsoft YaHei UI";
    font-size: 12px;
    color: #30343a;
}
QMainWindow, QWidget#startWorkspace {
    background: #eef0f7;
}
QWidget#quickAccessBar {
    background: #f1f3f8;
    border-bottom: 1px solid #d5d9e2;
    min-height: 24px;
    max-height: 24px;
}
QLabel#applicationTitle {
    font-size: 14px;
    color: #242832;
}
QToolButton#quickAccessButton {
    min-width: 22px;
    max-width: 22px;
    min-height: 21px;
    max-height: 21px;
    padding: 1px;
    border: 1px solid transparent;
    background: transparent;
}
QToolButton#quickAccessButton:hover {
    background: #fff3ca;
    border: 1px solid #d7ab4d;
}
QFrame#quickAccessDivider {
    color: #b8bec9;
    margin: 3px 4px;
}
QToolButton {
    border: 1px solid transparent;
    background: transparent;
    padding: 2px;
}
QToolButton:hover {
    background: #fff4cf;
    border: 1px solid #d9ae4d;
}
QToolButton:disabled {
    color: #9aa3af;
    background: transparent;
    border: 1px solid transparent;
}
QTabWidget#mainRibbon::pane {
    border-top: 1px solid #d9dde6;
    border-bottom: 1px solid #cbd0d9;
    background: #fbfbfd;
}
QTabWidget#mainRibbon QTabBar::tab {
    padding: 4px 10px 4px 10px;
    background: #edf0f6;
    border: none;
    border-right: 1px solid #cfd5df;
    font-size: 11px;
    min-height: 18px;
    color: #222936;
}
QTabWidget#mainRibbon QTabBar::tab:first {
    background: #e0ad34;
    border-right: 1px solid #bd8c20;
    color: #1d2530;
}
QTabWidget#mainRibbon QTabBar::tab:selected {
    background: #ffffff;
    border-right: 1px solid #c8ced8;
    font-weight: bold;
}
QTabWidget#mainRibbon QTabBar::tab:hover {
    background: #f7f8fb;
}
QFrame#ribbonGroup {
    background: #fbfbfd;
    border-right: 1px solid #d8dbe2;
}
QFrame#ribbonGroup QToolButton {
    padding: 1px 2px;
    font-size: 10px;
}
QFrame#ribbonGroup QToolButton[ribbonSize="large"] {
    min-height: 62px;
    max-height: 64px;
    min-width: 70px;
    max-width: 70px;
}
QFrame#ribbonGroup QToolButton[ribbonSize="medium"] {
    min-height: 62px;
    max-height: 64px;
    min-width: 62px;
    max-width: 62px;
}
QFrame#ribbonGroup QToolButton[ribbonSize="small"] {
    min-height: 20px;
    max-height: 21px;
    min-width: 74px;
    max-width: 74px;
    font-size: 10px;
    text-align: left;
}
QFrame#ribbonGroup QToolButton:disabled {
    color: #9aa3af;
}
QFrame#ribbonSmallColumn {
    background: #fbfbfd;
    min-height: 64px;
    max-height: 64px;
}
QLabel#ribbonGroupCaption {
    color: #656c77;
    border-top: 1px solid #e2e4e9;
    padding-top: 0px;
    font-size: 10px;
    min-height: 15px;
    max-height: 16px;
}
QLabel#ribbonPlaceholder {
    color: #747b87;
    padding: 16px;
}
QFrame#fileMenuPopup {
    background: #ffffff;
    border: 1px solid #aeb5c1;
}
QFrame#fileMenuSide {
    background: #f1f3f7;
    border-right: 1px solid #d7dbe4;
}
QFrame#fileMenuContent {
    background: #ffffff;
}
QLabel#fileMenuTitle {
    color: #202734;
    font-size: 16px;
    font-weight: bold;
    padding: 0px 0px 10px 0px;
}
QToolButton#fileMenuCommand {
    background: transparent;
    border: 1px solid transparent;
    color: #252b34;
    font-size: 14px;
    text-align: left;
    padding: 3px 8px;
}
QToolButton#fileMenuCommand:hover {
    background: #fff1c7;
    border: 1px solid #d7ad4e;
}
QToolButton#fileMenuCommand:disabled {
    color: #a4abb5;
    background: transparent;
    border: 1px solid transparent;
}
QFrame#fileMenuRecentCard {
    background: #ffffff;
    border: 1px solid transparent;
    min-height: 54px;
    max-height: 58px;
}
QFrame#fileMenuRecentCard:hover {
    background: #fff1c7;
    border: 1px solid #d7ad4e;
}
QLabel#fileMenuRecentIndex {
    color: #2f3742;
    font-size: 13px;
    min-width: 18px;
    max-width: 18px;
}
QLabel#fileMenuRecentName {
    color: #202734;
    font-size: 14px;
    font-weight: bold;
}
QLabel#fileMenuRecentPath {
    color: #656d7a;
    font-size: 11px;
    font-family: "Consolas", "Microsoft YaHei UI";
}
QFrame#fileMenuSeparator {
    color: #d0d3da;
    background: #d0d3da;
    max-height: 1px;
    margin: 5px 0px;
}
QFrame#fileMenuExitSeparator {
    color: #c7ccd6;
    background: #c7ccd6;
    max-height: 1px;
    margin: 7px 0px 5px 0px;
}
QWidget#projectsPanel, QFrame#projectLeftDock {
    background: #ffffff;
    border-right: 1px solid #d5d9e0;
}
QFrame#panelHeader, QFrame#logHeader {
    background: #f5dda5;
    border-top: 1px solid #d4b463;
    border-bottom: 1px solid #d4b463;
    min-height: 24px;
    max-height: 24px;
}
QLabel#panelTitle {
    font-weight: bold;
    font-size: 12px;
}
QToolButton#panelHeaderButton {
    min-width: 16px;
    max-width: 18px;
    min-height: 16px;
    max-height: 18px;
    padding: 0px;
    border: 1px solid transparent;
    color: #1f2732;
    font-size: 10px;
}
QToolButton#panelHeaderButton:hover {
    background: #fff4cf;
    border: 1px solid #d0a84a;
}
QFrame#panelCommands, QFrame#logTools {
    background: #f3f4f8;
    border-bottom: 1px solid #d9dde5;
}
QFrame#projectCard {
    background: #ffffff;
    border: 1px solid transparent;
    min-height: 52px;
    max-height: 62px;
}
QFrame#projectCard:hover {
    background: #fff5d9;
    border: 1px solid #e0c273;
}
QLabel#projectPreview {
    min-width: 70px;
}
QLabel#projectName {
    font-size: 12px;
    color: #2f3742;
}
QLabel#projectPath {
    color: #1f2732;
    font-family: "Consolas";
    font-size: 11px;
}
QLabel#workspaceWatermark {
    color: #c7cad8;
    font-size: 88px;
    font-weight: 300;
}
QWidget#messageLogPanel {
    background: #ffffff;
    border-top: 1px solid #d5dae3;
}
QPlainTextEdit {
    background: #ffffff;
    border: none;
    font-family: "Consolas", "Microsoft YaHei UI";
    font-size: 11px;
    padding: 4px;
}
QFrame#titledPanel, QFrame#dockTabPanel {
    background: #ffffff;
    border: none;
}
QTreeWidget#inputTree, QTreeWidget#resultsTree, QTreeWidget#casesTree,
QTreeWidget#templatesTree, QTreeWidget#processesTree, QTreeWidget#modelsTree,
QTreeWidget#windowsTree {
    background: #ffffff;
    border: none;
    outline: 0;
    font-family: "Consolas", "Microsoft YaHei UI";
    font-size: 11px;
}
QTreeWidget::item {
    min-height: 19px;
}
QFrame#bottomTabs {
    background: #f1f2f5;
    border-top: 1px solid #cbd0d8;
    min-height: 24px;
    max-height: 24px;
}
QLabel#bottomTab {
    background: #ffffff;
    border: 1px solid #c4c9d2;
    padding: 2px 9px;
}
QTabWidget#leftDockTabs::pane {
    border: none;
    border-bottom: 1px solid #c4cad4;
    background: #ffffff;
}
QTabWidget#leftDockTabs::tab-bar {
    alignment: left;
    left: 1px;
}
QTabWidget#leftDockTabs {
    qproperty-iconSize: 15px 15px;
}
QTabWidget#leftDockTabs QTabBar {
    background: #edf0f5;
}
QTabWidget#leftDockTabs QTabBar::tab {
    background: #e9edf4;
    border: 1px solid #bfc6d1;
    border-top-color: #d5dae2;
    padding: 1px 9px 1px 4px;
    margin: 0px;
    min-height: 18px;
    max-height: 20px;
    font-size: 11px;
    color: #1f3f78;
}
QTabWidget#leftDockTabs QTabBar::tab:selected {
    background: #ffffff;
    border-top-color: #bfc6d1;
    border-bottom-color: #ffffff;
    color: #111111;
    font-weight: bold;
}
QTabWidget#leftDockTabs QTabBar::tab:hover {
    background: #f7fbff;
}
QTabWidget#workspaceTabs::pane {
    border: 1px solid #b9c1ce;
    background: #ffffff;
}
QTabWidget#workspaceTabs QTabBar {
    background: #e8ebf1;
}
QTabWidget#workspaceTabs QTabBar::tab {
    background: #dce2eb;
    border: 1px solid #b9c1ce;
    border-bottom-color: #b4bcc8;
    padding: 3px 9px 3px 7px;
    min-width: 106px;
    min-height: 20px;
    color: #1f2d3d;
}
QTabWidget#workspaceTabs QTabBar::tab:selected {
    background: #f2c24e;
    border-color: #b68a28;
    font-weight: bold;
}
QTabWidget#workspaceTabs QTabBar::tab:hover {
    background: #eef3fb;
}
QTabWidget#workspaceTabs QTabBar::close-button {
    image: none;
    subcontrol-position: right;
    width: 11px;
    height: 11px;
    border: 1px solid transparent;
}
QTabWidget#workspaceTabs QTabBar::close-button:hover {
    background: #ffe3a6;
    border: 1px solid #c08f32;
}
QToolButton#workspaceAddButton {
    background: #e8ebf1;
    border: 1px solid #b9c1ce;
    color: #26313f;
    font-size: 16px;
    font-weight: bold;
    padding: 0px;
}
QToolButton#workspaceAddButton:hover {
    background: #fff4cf;
    border: 1px solid #d7ad4e;
}
QFrame#viewPage {
    background: #ffffff;
}
QFrame#viewToolbar {
    background: #f7f8fa;
    border-bottom: 1px solid #cbd0d8;
    min-height: 28px;
    max-height: 28px;
}
QToolButton#viewToolbarButton {
    border: 1px solid transparent;
    background: transparent;
    padding: 1px;
}
QToolButton#viewToolbarButton:hover {
    background: #fff4cf;
    border: 1px solid #d7ad4e;
}
QToolButton#viewToolbarButton[windowTool="true"] {
    background: #eef1f6;
    border: 1px solid #d4d9e2;
}
QFrame#viewToolbarDivider {
    color: #c8ced8;
    margin: 3px 4px;
}
QComboBox#viewSelector, QComboBox#scaleSelector {
    min-width: 68px;
    max-height: 22px;
    border: 1px solid #bfc5cf;
    background: #ffffff;
    padding: 2px;
}
QSplitter::handle {
    background: #d8dce4;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}
QStatusBar {
    background: #f4f5f8;
    border-top: 1px solid #d5dae3;
}
QFrame#parameterIntro {
    background: #f3f6fb;
    border: 1px solid #d7dee9;
    border-radius: 2px;
}
QLabel#parameterTitle {
    color: #26364a;
    font-size: 14px;
    font-weight: bold;
}
QLabel#parameterDescription {
    color: #667080;
    font-size: 11px;
}
QGroupBox#parameterSection {
    background: #ffffff;
    border: 1px solid #cfd6e1;
    border-radius: 2px;
    margin-top: 8px;
    font-weight: bold;
    color: #26364a;
}
QGroupBox#parameterSection::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    background: #ffffff;
}
QLabel#parameterLabel {
    min-height: 24px;
    color: #26313f;
}
QSpinBox#parameterSpinBox, QDoubleSpinBox#parameterSpinBox {
    min-height: 24px;
    background: #fbfcfe;
    border: 1px solid #b9c2cf;
    padding: 2px 4px;
}
QSpinBox#parameterSpinBox:focus, QDoubleSpinBox#parameterSpinBox:focus {
    border: 1px solid #5c86bd;
    background: #ffffff;
}
